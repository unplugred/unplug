<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel=StyleSheet href="<%= assets %>/stylesheet.css" type="text/css" media=screen>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap" rel="stylesheet">
		<style>
			body {
				background: #FFF !important;
				width: 100vw;
				height: 100vh;
				justify-content: center;
				align-items: center;
				pointer-events: none;
			}
			#content {
				width: 202px;
				height: 386px;
				background: repeating-linear-gradient(180deg, transparent 0px, transparent 47px, #DDD 47px, #DDD 48px), repeating-linear-gradient(90deg, #FFF 0px, #FFF, 4px, #DDD 4px, #DDD 5px, #FFF 5px, #FFF 48px) !important;
				border: .5px dashed #888;
				image-rendering: pixelated;
				flex: 0 0 auto;
				overflow: clip;
			}
			#circle {
				width: 252.5px;
				height: 252.5px;
				left: calc(50% - 126.25px);
				top: calc(50% - 126.25px);
			}
			#whitegradient {
				width: 100%;
				background: linear-gradient(to left, #FFF, transparent);
			}
			#right {
				width: 100%;
				height: 100%;
			}
			#left {
				font-size: 26px;
				padding: 0;
				overflow: visible;
				direction: ltr;
				transform: rotatez(-90deg) scaleX(1.4);
				transform-origin: top left;
				position: absolute;
				bottom: -68px;
				left: 10px;
				width: 262px;
				z-index: 2;
				margin-bottom: -5px;
			}
			.lefttitle {
				line-height: .7;
				margin-bottom: 0;
			}
			.lefticon {
				margin-right: 0;
			}
			#dots {
				right: 0;
				left: auto;
			}
			#pluginlogo {
				animation: none;
				top: 8px;
				z-index: 1;
			}
			#pluginlogo * {
				background-position: 9% top;
				background-size: 350%;
				width: 100%;
			}
			.pf #left {
				bottom: -80px;
			}
			.pf .lefticon {
				margin-right: -3px;
			}
			.vu #left {
				left: 3px;
			}
			.vu #pluginlogo * {
				background-position: 43% top;
				background-size: 89%;
			}
			.cb #left {
				bottom: -82px;
			}
			.cb .lefticon{
				margin-right: -9px;
			}
			.cb #pluginlogo * {
				background-position: 38% top;
				background-size: 250%;
			}
			.ps #left {
				left: 3px;
			}
			.ps .lefticon{
				margin-right: 2px;
			}
			.ps #pluginlogo * {
				background-position: 4% top;
				background-size: 250%;
			}
			.pnch #left {
				left: 7px;
			}
			.pnch #pluginlogo * {
				background-position: 69% top;
				background-size: 130%;
			}
			.mp #left {
				left: 7px;
			}
			.mp #pluginlogo * {
				background-position: 15% top;
				background-size: 160%;
			}
			.rb #left {
				left: 3px;
			}
			.rb .lefticon{
				margin-right: 2px;
			}
			.rb #pluginlogo * {
				background-position: 92% top;
				background-size: 250%;
			}
			.crmbl #pluginlogo * {
				background-position: 82% top;
				background-size: 150%;
			}
			.prsm #left {
				left: 5px;
			}
			.prsm .lefticon{
				margin-right: 2px;
			}
			.prsm #pluginlogo * {
				background-position: 29% top;
				background-size: 350%;
			}
			.sb #pluginlogo * {
				background-size: 124%;
			}
			.sb .lefticon{
				margin-right: 1px;
			}
			.da #left {
				bottom: -80px;
			}
			.da .lefticon {
				margin-right: -8px;
			}
			.sp .lefttitle {
				margin-top: -8px;
				margin-left: -2px;
			}
			.mc #left {
				bottom: -73px;
			}
			.mc .lefticon {
				margin-top: -5px;
			}
			.mm #pluginlogo * {
				background-position: 7% top;
			}
			.bndl #pluginlogo * {
				background-position: 28% top;
			}
			.bndl #left {
				bottom: -73px;
			}
		</style>
	</head>
	<body>
		<div id="content">
			<div id="bg">
				<svg id="diagonal">
					<line x1='0' y1='100%' x2='100%' y2='0'/>
					<line x1='0' y1='0' x2='100%' y2='100%'/>
				</svg>
				<div id="circle"></div>
				<div id="whitegradient"></div>
				<div id="rainbow"></div>
				<div id="dots">
					<div id="dotc" class="dot"></div><div id="doty" class="dot"></div><div id="dotm" class="dot"></div><div id="dotk" class="dot"></div>
				</div>
			</div>

			<div id="right" class="section">
				<a id="left" class="leftitem lefthover leftselected" href="javascript:void(0)">
					<div class="leftiteminner lefticonitem">
						<div class="lefticon" style="filter: none !important"></div>
						<div class="leftiteminnerinner" style="color: #24A6B3 !important">
							<div class="lefttitle" style="font-weight: 700 !important"></div>
						</div>
					</div>
				</a>
				<div id="pluginlogo"><div id="pluginlogo1"></div></div>
			</div>
		</div>

		<script type="text/javascript" src="/vsts.js"></script>
		<script>
			var i = -1;
			for(let m = 0; m < vsts.length; m++) {
				if(location.pathname.toLowerCase().endsWith(vsts[m].title.replace(/\s/g,"").toLowerCase())) {
					i = m;
					break;
				}
			}
			if(i !== -1) {
				document.getElementsByClassName("lefticon")[0].style.backgroundImage = "url(/"+vsts[i].id+"/icon.svg)";
				document.getElementsByClassName("lefttitle")[0].innerText = vsts[i].title;
				document.getElementsByClassName("leftiteminner")[0].className += " " + vsts[i].color;
				document.body.className = vsts[i].id;
				document.getElementById("pluginlogo1").style.backgroundImage = "url(/"+vsts[i].id+"/text.webp)";
				document.getElementById("rainbow").style.backgroundPositionY = (String)((i*-1024)/(vsts.length-1))+"px";
				document.title = vsts[i].title;
			}
		</script>
	</body>
</html>
